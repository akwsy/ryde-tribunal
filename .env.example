# Ryde Tribunal — configuration template. Names and shapes only, NEVER values.
# Copy this repository-root template to backend/.env and fill in locally.
# backend/.env is gitignored. The launcher supplies the repository root on PYTHONPATH.

# --- Database (D-13: local Postgres 16, no Docker on this machine) ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=ryde_tribunal
POSTGRES_USER=USER
POSTGRES_PASSWORD=replace-with-local-password
# SQLAlchemy / Alembic style URL — used for MIGRATIONS.
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@localhost:5432/ryde_tribunal
# Plain psycopg DSN (NO '+psycopg' driver segment) — used by the seed generator and the
# database reader, which connect with psycopg directly. The two forms are not interchangeable:
# passing the SQLAlchemy URL to psycopg fails with 'missing "=" after ... in connection info string'.
PSYCOPG_DSN=postgresql://USER:PASSWORD@localhost:5432/ryde_tribunal
# Backend read path — connects as the SELECT-only role the database specialist creates.
READ_DATABASE_DSN=postgresql://ryde_backend_readonly:PASSWORD@localhost:5432/ryde_tribunal
# Backend write path — its own `tribunal` schema. Separate connection, separate privilege level.
TRIBUNAL_DATABASE_DSN=postgresql://USER:PASSWORD@localhost:5432/ryde_tribunal
# Phase One import path — a separate least-privilege role that can insert company records into
# ride_data. Do not use the read-only role or a database superuser for app uploads.
IMPORT_DATABASE_DSN=postgresql://ryde_data_importer:PASSWORD@localhost:5432/ryde_tribunal
IMPORT_MAX_UPLOAD_BYTES=52428800

# --- Synthetic data seeds (repeatable generation) ---
RIDE_DATA_SEED=ride-data-v1
CASE_ARCHIVE_SEED=case-archive-v1

# --- Model provider (D-04: provider-agnostic) ---
# deterministic_mock | openai_compatible
MODEL_PROVIDER=deterministic_mock
MODEL_PROVIDER_NAME=
MODEL_BASE_URL=
MODEL_NAME=
MODEL_API_KEY=
MODEL_TIMEOUT_S=30

# --- External information source (I-8: quarantined, optional) ---
EXTERNAL_INFO_ENABLED=false
EXTERNAL_INFO_BASE_URL=
EXTERNAL_INFO_API_KEY=

# --- Policy and decision parameters (D-08..D-11) ---
POLICY_VERSION=ryde-policy-0.1.2
JUDGING_CONFIG_PATH=
ESCALATION_CONFIDENCE_THRESHOLD=0.70
HIGH_IMPACT_AMOUNT_CENTS=2500
GOODWILL_CAP_CENTS=1500
CURRENCY=SGD
TIMEZONE=Asia/Singapore

# --- Backend ---
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
LOG_LEVEL=info

# --- Frontend ---
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000/api/v1
NEXT_PUBLIC_FIXTURE_MODE=false
