# Ryde Tribunal — configuration template. Names and shapes only, NEVER values.
# Copy to .env and fill in locally. .env must be gitignored.

# --- Database (D-13: local Postgres 16, no Docker on this machine) ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=ryde_tribunal
POSTGRES_USER=
POSTGRES_PASSWORD=
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@localhost:5432/ryde_tribunal

# --- Synthetic data seeds (repeatable generation) ---
RIDE_DATA_SEED=ride-data-v1
CASE_ARCHIVE_SEED=case-archive-v1

# --- Model provider (D-04: provider-agnostic) ---
# deterministic_mock | openai_compatible
MODEL_PROVIDER=deterministic_mock
MODEL_BASE_URL=
MODEL_NAME=
MODEL_API_KEY=
MODEL_TIMEOUT_S=30

# --- External information source (I-8: quarantined, optional) ---
EXTERNAL_INFO_ENABLED=false
EXTERNAL_INFO_BASE_URL=
EXTERNAL_INFO_API_KEY=

# --- Policy and decision parameters (D-08..D-11) ---
POLICY_VERSION=ryde-policy-0.1.0
ESCALATION_CONFIDENCE_THRESHOLD=0.70
HIGH_IMPACT_AMOUNT_CENTS=2500
GOODWILL_CAP_CENTS=1500
FRAUD_RISK_ESCALATION_THRESHOLD=0.60
CURRENCY=SGD
TIMEZONE=Asia/Singapore

# --- Backend ---
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
LOG_LEVEL=info

# --- Frontend ---
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000/api/v1
NEXT_PUBLIC_FIXTURE_MODE=false
